<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    Test runner configuration for the POS System test suite.
    Coverlet.msbuild settings are configured via MSBuild properties
    in Directory.Build.props for automatic application.
  -->
  <RunConfiguration>
    <MaxCpuCount>0</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <TestSessionTimeout>600000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
